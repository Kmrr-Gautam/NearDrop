PROJECT_NAME=NearDrop API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-long-random-secret-key-for-jwt-signing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=sqlite:///./neardrop.db
CORS_ORIGINS=["http://localhost:3000","http://10.0.2.2:3000"]
SESSION_EXPIRE_MINUTES=10
MAX_FILES_PER_TRANSFER=250
MAX_METADATA_SIZE_BYTES=10485760
ALLOWED_PROTOCOL_VERSIONS=["1.0","2.0"]
LOG_LEVEL=INFO
